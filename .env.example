# MongoDB Atlas bağlantı dizesi
# Örnek: mongodb+srv://<kullanici>:<parola>@<kume>.mongodb.net/?retryWrites=true&w=majority
# Parolayı ASLA koda veya bu dosyaya yazmayın; gerçek değer .env.local içinde durur.
MONGODB_URI=
MONGODB_DB=sinaptiklab

# Kanonik site adresi (ör. https://sinaptiklab.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
