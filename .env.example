# ── Sinaptiklab ortam değişkenleri (BRIEF §12.2) ──
# Bu dosyayı .env.local olarak kopyalayıp doldurun. .env* asla commit edilmez.

# Zorunlu (Faz 1'den itibaren)
NEXT_PUBLIC_SITE_URL=https://sinaptiklab.com
MONGODB_URI=
MONGODB_DB=sinaptiklab

# Geçici /admin Basic Auth (ADR 0007; boşsa /admin 404 döner, Faz 7'de kalkacak)
ADMIN_USER=
ADMIN_PASS=

# Auth.js (Faz 7)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-posta / bülten (Faz 7)
RESEND_API_KEY=
NEWSLETTER_FROM=

# Rate limit / cache (Faz 5+)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Medya (Faz 2)
BLOB_READ_WRITE_TOKEN=

# Embedding üretimi — yalnızca script/yayın hattında kullanılır (Faz 6)
OPENAI_API_KEY=

# SEO / operasyon (Faz 4+)
REVALIDATE_SECRET=
INDEXNOW_KEY=  # yayin bildirimleri icin — .env.local'de uretildi, Vercel'e de ekleyin

# Analitik (Faz 9)
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
